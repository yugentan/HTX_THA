# Copy to .env (local) and .env.production (production), then fill in real values.
NODE_ENV=development
PORT=3000
# Origins allowed to call this API. Comma-separate for more than one.
CORS_ORIGIN=http://localhost:3001
# Host is localhost when running with npm, the compose service name inside docker.
DATABASE_URL=postgres://user:password@localhost:5432/dbname
# Optional: enables infer_skills on POST /api/v1/tasks. Get a free key at aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
