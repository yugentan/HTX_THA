# Copy to .env (local) and .env.production (production), then fill in real values.
# NOTE: these values are inlined into the browser bundle - never put secrets here.
# API_BASE_URL must be a fully qualified origin - the browser resolves it directly,
# so a relative path like /api would need a proxy in front of the app.
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3000
